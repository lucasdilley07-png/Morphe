rules_version = '2';

// Morphe — security rules (Phases 1–3).
// Phase 1: each user owns exactly their own profile document.
// Phase 3 (coach↔client, designed 2026-07-06): a coach with an ACTIVE
// connection may read a linked athlete's full profile and workout logs.
// Product decisions baked in here:
//   • Linking = reusable coach code + the coach approves each request.
//   • A linked coach sees the FULL athlete profile (incl. injuries, body
//     metrics, goals) — chosen for coaching quality over granular privacy.
//   • Coach signup is open; users/{uid}.coach.verified is reserved for a
//     future credential-check gate and can never be set true from the client.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    // Human-pace stamps (fix wave 2026-10-13): a stamp may stay as it is or
    // move to this request's own time — never back to null or an old date,
    // which reset the pace limit.
    function paceStampHonest(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null)
        || request.resource.data.get(field, null) == request.time;
    }
    function paceStampsHonest() {
      return paceStampHonest('lastPostAt') && paceStampHonest('lastCommentAt')
        && paceStampHonest('lastMessageAt') && paceStampHonest('lastConnectAt');
    }
    function paceStampFresh(field) {
      return !(field in request.resource.data) || request.resource.data[field] == request.time;
    }
    // Competition rows (fix wave 2026-10-13): a known shape, a short name,
    // and a ceiling no honest week or month reaches — a REST call can no
    // longer post 10,000 sets or a paragraph as a name.
    function honestEntryName() {
      return request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 60;
    }
    // An accepted connection between the caller and `other`, either
    // direction (private accounts, 2026-10-12).
    function connectedWith(other) {
      let ab = /databases/$(database)/documents/connectRequests/$(request.auth.uid + '_' + other);
      let ba = /databases/$(database)/documents/connectRequests/$(other + '_' + request.auth.uid);
      return (exists(ab) && get(ab).data.status == 'accepted')
        || (exists(ba) && get(ba).data.status == 'accepted');
    }

    // Active coach↔client link. Connection ids are deterministic —
    // "{coachUid}_{athleteUid}" — so the check is a single doc lookup.
    function isActiveCoachOf(athleteUid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/connections/$(request.auth.uid + '_' + athleteUid))
        && get(/databases/$(database)/documents/connections/$(request.auth.uid + '_' + athleteUid)).data.status == 'active';
    }

    // True when the write does NOT try to flip a verification flag to true.
    // Both the coach credential flag and the account-level verified badge are
    // granted ONLY from the console/a Function — a client-set checkmark would
    // be a forged trust signal. A client may keep an already-granted true
    // (checked at the call sites via resource) but never mint one.
    function keepsVerifiedHonest() {
      return request.resource.data.get('coach', {}).get('verified', false) != true
        && request.resource.data.get('verified', false) != true
        && request.resource.data.get('creator', false) != true;
    }

    // Human-only policy (2026-10-10): every post, comment and message
    // carries a server-time stamp on the writer's own users/{uid} doc,
    // written in the SAME batch (lastPostAt / lastCommentAt /
    // lastMessageAt). The content write is allowed only when the stamp
    // after the batch equals request.time AND the stamp before it is at
    // least `seconds` old — a pace enforced where no client can skip it.
    function priorStamp(field) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get(field, null)
        : null;
    }
    function humanPaced(field, seconds) {
      return getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get(field, null) == request.time
        && (priorStamp(field) == null
            || priorStamp(field) <= request.time - duration.value(seconds, 's'));
    }

    // Creator Coach (2026-10-05): a role granted ONLY by the admin tool
    // (users/{uid}.creator). The application is filed on the website; the
    // app reads its status and, once approved, publishes under this check.
    function isCreator() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('creator', false) == true;
    }

    // The user's profile document. Private to its owner, plus read access
    // for an actively linked coach (full-profile decision above).
    match /users/{uid} {
      allow read:   if isOwner(uid) || isActiveCoachOf(uid);
      allow create: if isOwner(uid) && keepsVerifiedHonest()
        && paceStampFresh('lastPostAt') && paceStampFresh('lastCommentAt')
        && paceStampFresh('lastMessageAt') && paceStampFresh('lastConnectAt');
      // Per-flag: a client may CARRY an already-granted true, never mint one.
      allow update: if isOwner(uid)
        && (request.resource.data.get('coach', {}).get('verified', false) != true
            || resource.data.get('coach', {}).get('verified', false) == true)
        && (request.resource.data.get('verified', false) != true
            || resource.data.get('verified', false) == true)
        && (request.resource.data.get('creator', false) != true
            || resource.data.get('creator', false) == true)
        && paceStampsHonest();
      // Account deletion is user-initiated IN the app (App Store 5.1.1(v)):
      // the owner deletes their own root doc; state/* and coachShare are
      // removed by the same flow, and the Auth user is deleted last.
      allow delete: if isOwner(uid);

      // The user's own workout data. Linked coaches read, never write.
      match /workoutLogs/{logId} {
        allow read:  if isOwner(uid) || isActiveCoachOf(uid);
        allow write: if isOwner(uid);
      }

      // Cloud backup blobs (state/profile, state/logs, state/weightHistory —
      // { schemaVersion, json, updatedAt }). Owner-only. NOTE: this block was
      // MISSING while FirebaseCloudBackup already wrote here — the backup
      // fail-secured into doing nothing. This makes it real.
      match /state/{doc} {
        allow read, write: if isOwner(uid);
      }
      match /customWorkouts/{id} {
        allow read, write: if isOwner(uid);
      }

      // Post-workout debriefs — one small doc per debrief (audit 18, P0:
      // this block was MISSING while the client already wrote here, so
      // every push fail-secured into permanent retry). Owner-only, with
      // the same shape bounds the client enforces.
      match /debriefs/{debriefId} {
        allow read:   if isOwner(uid);
        // Full-shape validation (audit 19, P2): typed fields, bounded
        // sizes, and no extra keys — the referrals block's hasOnly
        // pattern applied here.
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(
               ['workoutTitle', 'workoutTemplateID', 'intensity',
                'rating', 'changeRequest', 'completedAt', 'updatedAt'])
          && request.resource.data.workoutTitle is string
          && request.resource.data.workoutTitle.size() <= 200
          && request.resource.data.intensity is string
          && request.resource.data.intensity.size() <= 20
          && request.resource.data.rating is int
          && request.resource.data.rating >= 0
          && request.resource.data.rating <= 10
          && request.resource.data.changeRequest is string
          && request.resource.data.changeRequest.size() <= 300
          && request.resource.data.completedAt is timestamp;
        allow delete: if isOwner(uid);
      }

      // Personal appointments — one doc per appointment (append-scale, not a
      // state/* JSON blob). Owner-only ON PURPOSE: unlike workoutLogs there
      // is no coach read, because an appointment can name third parties
      // (withName) who never agreed to be visible to a linked coach.
      // NOTE: publish via `python3 Tools/publish_rules.py` (compiles,
      // releases, byte-verifies), then behavioral-check with
      // `python3 Tools/verify_rules_live.py`.
      match /appointments/{id} {
        allow read, write: if isOwner(uid);
      }

      // Feed bookmarks — one doc per saved post ({ savedAt }). Private on
      // purpose: what someone saves is their own business, so no coach read.
      match /savedPosts/{postId} {
        allow read, write: if isOwner(uid);
      }

      // Follow graph — one doc per followed account ({ createdAt }).
      // Owner-only on purpose: who you follow is your business, and honest
      // follower COUNTS wait for a server aggregation nobody can forge.
      match /following/{targetUid} {
        allow read, write: if isOwner(uid);
      }

      // Referral receipts — one doc per athlete who joined through this
      // user's invite link ({ createdAt }). The REFERRED user creates
      // their own receipt: the doc id is pinned to their auth uid, so a
      // receipt can't be minted for anyone else, can't be self-referred,
      // and can't be re-minted (no update). Only the recruiter reads the
      // ledger; the referred user keeps delete for account erasure.
      // Forging the count costs one real signed-in account per fake row —
      // the same trust level as the rest of the social graph.
      match /referrals/{referredUid} {
        allow read: if isOwner(uid);
        allow create: if isSignedIn()
          && request.auth.uid == referredUid
          && request.auth.uid != uid
          && request.resource.data.keys().hasOnly(['createdAt']);
        allow update: if false;
        allow delete: if isSignedIn() && request.auth.uid == referredUid;
      }

      // Block list — one doc per blocked account ({ name, createdAt }).
      // Owner-only: who you block is your business. The app filters every
      // feed/comment/search render through this list.
      match /blocked/{targetUid} {
        allow read, write: if isOwner(uid);
      }

      // Athlete-consented coach visibility. The athlete's device writes a
      // compact progress summary that NAMES the one coach allowed to read
      // it — consent IS the document, and deleting it (the toggle-off path)
      // revokes instantly. This deliberately does NOT ride isActiveCoachOf:
      // claimed managed clients have no connections/ doc, and the athlete
      // naming the reader is the stronger, simpler consent anyway.
      match /coachShare/{doc} {
        allow read: if isOwner(uid)
          || (isSignedIn() && request.auth.uid == resource.data.get('coachUid', ''));
        allow write: if isOwner(uid);
      }
    }

    // First-party telemetry — WRITE-ONLY, own-uid, tiny fixed shape. The
    // app's own measurement (disclosed in the privacy policy): no third-
    // party SDK ever sees it, clients can never read it back, and the only
    // reader is the founder's service-account report tool.
    // Website waitlist (fix wave 2026-10-13): anyone may add one email;
    // nobody can read, change or delete entries from a client. Exported with
    // the service account (Tools/export_waitlist.py).
    match /waitlist/{entryId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'source'])
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 6
        && request.resource.data.email.size() <= 120
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$')
        && (!('source' in request.resource.data)
            || (request.resource.data.source is string && request.resource.data.source.size() <= 24));
      allow read, update, delete: if false;
    }

    match /telemetry/{eventId} {
      // Own events readable/deletable ONLY by their author — that's what
      // makes the policy's "deleted with your account" true client-side.
      // Nobody can ever read anyone else's events; the aggregate reader is
      // the founder's service account (Tools/metrics_report.py).
      allow read, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'day', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 40
        && request.resource.data.day is string
        && request.resource.data.day.size() <= 10;
      allow update: if false;
    }

    // Abuse reports — WRITE-ONLY from clients. Any signed-in user may file
    // one about a post, comment, or user; nobody can read, edit, or delete
    // them from an app. Review happens with the service account via
    // Tools/review_reports.py (App Store 1.2: report + human action).
    match /reports/{reportId} {
      allow read: if false;
      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['reporterUid', 'kind', 'targetId', 'targetUid', 'reason',
              'excerpt', 'status', 'createdAt'])
        && request.resource.data.kind in ['post', 'comment', 'user']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 1
        && request.resource.data.reason.size() <= 60
        && request.resource.data.excerpt is string
        && request.resource.data.excerpt.size() <= 300
        && request.resource.data.status == 'open';
      allow update, delete: if false;
    }

    // Username uniqueness map. Readable by all (to check availability at
    // sign-up), claimable only by the signed-in user for their own uid.
    // Owners may re-write their own entry (a same-name re-claim is a no-op
    // write) and delete it — that's how a rename releases the old name in
    // the same transaction that claims the new one. A name someone ELSE
    // holds stays untouchable.
    match /usernames/{username} {
      // Signed-in only (1000-user audit #5): `if true` let ANYONE with the
      // public web config enumerate every (username, uid) pair AND drain
      // the daily read quota unauthenticated. Every in-app reader (claim
      // check, directory search) runs signed in.
      allow get:    if isSignedIn();
      // Directory search is a bounded prefix scan; an unbounded list would
      // let one client page through every member.
      // Browsing lists public handles only (private accounts, 2026-10-12);
      // a direct get by name stays open so claims can check availability.
      allow list:   if isSignedIn() && request.query.limit <= 50
        && resource.data.private == false;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Coach codes: ONE reusable, shareable code per coach (e.g. MORPHE-4X2K9).
    // Any signed-in user can resolve a code to a coach uid (that's how the
    // athlete's "enter your coach's code" field works). A coach claims a code
    // only for themself; codes are immutable from the client (rotation and
    // one-code-per-coach enforcement move to a Cloud Function later).
    match /coachCodes/{code} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.coachUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['coachUid', 'createdAt']);
      allow update, delete: if false;
    }

    // Coach↔client connections. Deterministic id "{coachUid}_{athleteUid}".
    // Lifecycle: athlete enters a coach code → creates a PENDING request →
    // the coach approves (active) or declines (declined) → either side can
    // end the link at any time (revoked). Revoking kills the coach's read
    // access instantly via isActiveCoachOf above.
    match /connections/{connId} {
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.coachUid
            || request.auth.uid == resource.data.athleteUid);

      // Only the athlete creates a request, only as pending, only under the
      // deterministic id, and never to themself.
      allow create: if isSignedIn()
        && request.resource.data.athleteUid == request.auth.uid
        && request.resource.data.coachUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && connId == request.resource.data.coachUid + '_' + request.resource.data.athleteUid;

      // Participants move the status; the two uids are immutable.
      allow update: if isSignedIn()
        && request.resource.data.coachUid == resource.data.coachUid
        && request.resource.data.athleteUid == resource.data.athleteUid
        && (
          // The coach decides on a pending request…
          (request.auth.uid == resource.data.coachUid
            && resource.data.status == 'pending'
            && request.resource.data.status in ['active', 'declined'])
          // …and either side can revoke at any time.
          || ((request.auth.uid == resource.data.coachUid
               || request.auth.uid == resource.data.athleteUid)
              && request.resource.data.status == 'revoked')
        );

      allow delete: if false;
    }

    // Member↔member connect requests (Quick Add, 2026-10-10). Deterministic
    // id "{fromUid}_{toUid}". The sender creates it pending (human-paced:
    // one every 10 s, stamped in the same batch; never to themself; never
    // while the reverse request exists; never to someone who blocked them);
    // the receiver accepts or declines; either side removes. Names are
    // display text, bounded, never trusted.
    match /connectRequests/{reqId} {
      function isParty() {
        return isSignedIn()
          && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      }
      function reversePath() {
        return /databases/$(database)/documents/connectRequests/$(request.resource.data.toUid + '_' + request.resource.data.fromUid);
      }
      allow get: if isParty();
      // Only your own rows, in either direction — never the whole graph.
      allow list: if isSignedIn() && request.query.limit <= 200
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && reqId == request.resource.data.fromUid + '_' + request.resource.data.toUid
        // The other direction may exist only as a dead request.
        && (!exists(reversePath()) || get(reversePath()).data.status in ['declined', 'removed'])
        && request.resource.data.keys().hasOnly(['fromUid', 'toUid', 'fromName', 'toName', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 60
        && request.resource.data.toName is string && request.resource.data.toName.size() <= 60
        && !exists(/databases/$(database)/documents/users/$(request.resource.data.toUid)/blocked/$(request.auth.uid))
        && humanPaced('lastConnectAt', 10);
      allow update: if isParty()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && (
          (request.auth.uid == resource.data.toUid
            && resource.data.status == 'pending'
            && request.resource.data.status in ['accepted', 'declined'])
          || request.resource.data.status == 'removed'
          // The sender may re-send a dead request (paced like a new one).
          || (request.auth.uid == resource.data.fromUid
              && resource.data.status in ['declined', 'removed']
              && request.resource.data.status == 'pending'
              && humanPaced('lastConnectAt', 10))
        );
      allow delete: if false;
    }

    // Train Together parties. The 6-char doc id is the join code — knowing it
    // is the invite (read by code; no listing). Hosts create/steer the party;
    // every member owns exactly their own member doc.
    match /parties/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.hostID == request.auth.uid;
      allow update: if isSignedIn() && resource.data.hostID == request.auth.uid;
      allow delete: if false;

      match /members/{uid} {
        allow read: if isSignedIn();
        allow write: if isOwner(uid);
      }

      match /nudges/{nudgeId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.fromID == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Verification requests (one per user, doc id = uid). The user submits a
    // selfie + note; the Morphe team reviews in the console and grants
    // users/{uid}.verified there — the client can only ever ask. Status is
    // console-managed after submission: the client writes exactly 'pending'
    // and may resubmit only while still pending (or after a 'declined').
    match /verificationRequests/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(
             ['uid', 'name', 'username', 'role', 'note', 'selfieJPEG', 'status', 'createdAt'])
        && request.resource.data.uid == uid;
      allow update: if isOwner(uid)
        && resource.data.status in ['pending', 'declined']
        && request.resource.data.status == 'pending'
        && request.resource.data.uid == uid;
      allow delete: if isOwner(uid);
    }

    // Creator Coach applications — filed from the website by the signed-in
    // applicant, one per account. The applicant reads their own and may
    // resubmit after a decline; status is set to 'approved' only by the
    // admin tool (which also flips users/{uid}.creator).
    match /coachApplications/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(
             ['uid', 'email', 'name', 'username', 'specialty', 'credentials',
              'experience', 'links', 'plan', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.username is string && request.resource.data.username.size() <= 40
        && request.resource.data.specialty is string && request.resource.data.specialty.size() <= 120
        && request.resource.data.credentials is string && request.resource.data.credentials.size() <= 600
        && request.resource.data.experience is string && request.resource.data.experience.size() <= 600
        && request.resource.data.links is string && request.resource.data.links.size() <= 600
        && request.resource.data.plan is string && request.resource.data.plan.size() <= 1200;
      allow update: if isOwner(uid)
        && resource.data.status in ['pending', 'declined']
        && request.resource.data.status == 'pending'
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(
             ['uid', 'email', 'name', 'username', 'specialty', 'credentials',
              'experience', 'links', 'plan', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.username is string && request.resource.data.username.size() <= 40
        && request.resource.data.specialty is string && request.resource.data.specialty.size() <= 120
        && request.resource.data.credentials is string && request.resource.data.credentials.size() <= 600
        && request.resource.data.experience is string && request.resource.data.experience.size() <= 600
        && request.resource.data.links is string && request.resource.data.links.size() <= 600
        && request.resource.data.plan is string && request.resource.data.plan.size() <= 1200;
      allow delete: if isOwner(uid);
    }

    // What creators publish. Every signed-in member reads; only an
    // approved creator writes, and only under their own uid.
    match /creatorWorkouts/{id} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 100;
      allow create: if isCreator()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 600
        && request.resource.data.exercises is list && request.resource.data.exercises.size() <= 20;
      allow update: if isCreator() && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 600
        && request.resource.data.exercises is list && request.resource.data.exercises.size() <= 20;
      allow delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;
    }

    match /creatorNotes/{id} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 100;
      allow create: if isCreator()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() <= 80
        && request.resource.data.body is string && request.resource.data.body.size() <= 2000;
      allow update: if isCreator() && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() <= 80
        && request.resource.data.body is string && request.resource.data.body.size() <= 2000;
      allow delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;
    }

    // Public listing of a creator's challenge. The challenge doc itself
    // is created the ordinary way; joining uses the ordinary code path.
    match /openChallenges/{code} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 50;
      allow create: if isCreator()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.code == code
        && request.resource.data.title is string && request.resource.data.title.size() <= 60
        && exists(/databases/$(database)/documents/challenges/$(code))
        && get(/databases/$(database)/documents/challenges/$(code)).data.hostUid == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.hostUid == request.auth.uid;
    }

    // Coach-managed client profiles (pre-signup) + claim handoff.
    // The document id IS the invite code — possession of the code is the
    // authorization to claim, exactly like party join codes. The coach owns
    // the profile until the athlete claims it; after that it's frozen (the
    // history has moved into the athlete's own account).
    match /managedClients/{code} {
      // GET requires knowing the code (unguessable enough at 31^6); LIST is
      // the owning coach's roster query OR the claimed athlete's own docs
      // (that's how coach-assigned programs reach their Train tab).
      allow get: if isSignedIn();
      allow list: if isSignedIn()
        && (resource.data.coachUid == request.auth.uid
            || resource.data.claimedByUid == request.auth.uid);

      // Only a coach creates one, for themself, unclaimed.
      allow create: if isSignedIn()
        && request.resource.data.coachUid == request.auth.uid
        && request.resource.data.status == 'unclaimed';

      // Three legal updates:
      //   1. The owning coach edits/logs while the profile is unclaimed.
      //   2. Any signed-in athlete atomically claims an unclaimed profile for
      //      THEMSELF — flipping status and stamping claimedByUid, nothing
      //      else (logs, identity, and assignments frozen through the claim).
      //   3. Program delivery: the owning coach updates ONLY the assignments
      //      on a CLAIMED doc — the rest is the athlete's history now.
      allow update: if isSignedIn()
        && request.resource.data.coachUid == resource.data.coachUid
        && (
          (request.auth.uid == resource.data.coachUid
            && resource.data.status == 'unclaimed'
            // Same assignments cap as the claimed branch — an unbounded
            // field could push the doc past Firestore's 1MB write limit
            // and brick every future update (launch audit P2-22).
            && request.resource.data.get('assignmentsJSON', '[]').size() <= 200000)
          || (resource.data.status == 'unclaimed'
            && request.resource.data.status == 'claimed'
            && request.resource.data.claimedByUid == request.auth.uid
            && request.resource.data.logsJSON == resource.data.logsJSON
            && request.resource.data.get('assignmentsJSON', '[]') == resource.data.get('assignmentsJSON', '[]')
            && request.resource.data.athleteID == resource.data.athleteID)
          || (request.auth.uid == resource.data.coachUid
            && resource.data.status == 'claimed'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['assignmentsJSON', 'updatedAt'])
            && request.resource.data.assignmentsJSON is string
            && request.resource.data.assignmentsJSON.size() <= 200000)
        );

      // A coach can delete an unclaimed profile; a claimed one is the
      // athlete's history now.
      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.coachUid
        && resource.data.status == 'unclaimed';
    }

    // Weekly leaderboard — global, opt-in. weekKey is the Monday-anchored ISO
    // year-week ("2026-W30"); each signed-in user owns exactly one entry per
    // week (doc id = uid). Honesty guarantees enforced here:
    //   • a user writes ONLY their own row (no ghost competitors),
    //   • score/workouts must be non-negative integers,
    //   • `verified` may only mirror a badge the server actually granted
    //     (users/{uid}.verified) — no self-minted blue checks on the board,
    //   • no client deletes: leaving the board stops future posts, but the
    //     already-posted week stays (disclosed in the opt-in copy).
    // NOTE: editing this file changes nothing until published — run
    // `python3 Tools/publish_rules.py` (compiles, releases, byte-verifies),
    // then `python3 Tools/verify_rules_live.py` for behavioral proof.
    match /leaderboards/{weekKey}/entries/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'verified', 'score', 'workouts', 'private', 'updatedAt'])
        && honestEntryName()
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 600
        && request.resource.data.get('workouts', 0) is int
        && request.resource.data.get('workouts', 0) <= 28
        && request.resource.data.workouts is int
        && request.resource.data.workouts >= 0
        && (request.resource.data.get('verified', false) != true
            || get(/databases/$(database)/documents/users/$(uid)).data.get('verified', false) == true);
      allow delete: if false;

      // Respect — the one-tap reaction on an athlete's WEEK (2026-09-30,
      // from the engagement research: every logged unit a friend can see
      // gets a one-tap acknowledgment). Referral-receipt shape: the GIVER
      // writes their own doc under the receiver's entry, create-only,
      // giver-revocable, never updatable. Counts come from counting docs —
      // no forgeable counters.
      match /respect/{giverUid} {
        allow read: if isSignedIn();
        allow create: if isOwner(giverUid)
          && giverUid != uid
          && request.resource.data.keys().hasOnly(['createdAt']);
        allow update: if false;
        allow delete: if isOwner(giverUid);
      }
    }

    // Boards with codes (2026-10-10): a named group whose 6-char doc id IS
    // the join code — get by code, never list. The host creates it
    // (immutable); standings live per ISO week under weeks/{weekKey}/
    // entries/{uid} with the weekly board's honesty checks (own row only,
    // non-negative ints, verified only if server-granted, no deletes),
    // and the same respect receipts.
    match /boards/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'hostUid', 'hostName', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 40
        && request.resource.data.hostName is string
        && request.resource.data.hostName.size() <= 60;
      allow update, delete: if false;

      match /weeks/{weekKey}/entries/{uid} {
        allow read: if isSignedIn();
        allow create, update: if isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'verified', 'score', 'workouts', 'private', 'updatedAt'])
          && honestEntryName()
          && request.resource.data.score is int
          && request.resource.data.score >= 0
          && request.resource.data.score <= 600
          && request.resource.data.workouts is int
          && request.resource.data.workouts >= 0
          && (request.resource.data.get('verified', false) != true
              || get(/databases/$(database)/documents/users/$(uid)).data.get('verified', false) == true);
        allow delete: if false;

        match /respect/{giverUid} {
          allow read: if isSignedIn();
          allow create: if isOwner(giverUid)
            && giverUid != uid
            && request.resource.data.keys().hasOnly(['createdAt']);
          allow update: if false;
          allow delete: if isOwner(giverUid);
        }
      }
    }

    // Code-joinable challenges. The 6-char doc id is the join code — knowing
    // it is the invite (get by code; no listing), exactly like parties. The
    // host creates the challenge doc (immutable afterward, host-set window
    // capped at 30 days); every member owns exactly their own member doc,
    // with the same non-negative-score and honest-verified checks as the
    // weekly board.
    match /challenges/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 60
        && request.resource.data.metric in ['sets', 'workouts']
        && request.resource.data.startsAt is timestamp
        && request.resource.data.endsAt is timestamp
        && request.resource.data.endsAt.toMillis() > request.resource.data.startsAt.toMillis()
        && request.resource.data.endsAt.toMillis() - request.resource.data.startsAt.toMillis() <= 30 * 24 * 60 * 60 * 1000;
      allow update, delete: if false;

      match /members/{uid} {
        allow read: if isSignedIn();
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['name', 'verified', 'score', 'private', 'updatedAt'])
          && honestEntryName()
          && request.resource.data.score is int
          && request.resource.data.score >= 0
          && request.resource.data.score <= 3000
          && (request.resource.data.get('verified', false) != true
              || get(/databases/$(database)/documents/users/$(uid)).data.get('verified', false) == true);
        allow delete: if false;
      }
    }

    // Real 1:1 coach↔athlete messaging. Thread id is deterministic —
    // "{coachUid}_{athleteUid}" — same scheme as connections, so both sides
    // derive the same doc without a lookup. Participants (and only they) read
    // and write; the uid/name fields freeze at creation; messages are
    // immutable once sent (honest history — no edits, no deletions). Rules
    // can't query managedClients by claimedByUid, so the real-link guarantee
    // is: the coach client only creates a thread from a CLAIMED roster entry,
    // and rules pin every thread to exactly its two named participants.
    // NOTE: editing this file changes nothing until published — run
    // `python3 Tools/publish_rules.py` (compiles, releases, byte-verifies),
    // then `python3 Tools/verify_rules_live.py` for behavioral proof.
    match /threads/{threadId} {
      function isThreadParticipant() {
        return isSignedIn()
          && (request.auth.uid == resource.data.coachUid
              || request.auth.uid == resource.data.athleteUid);
      }

      allow get: if isThreadParticipant();
      // list only via a participant-scoped query (whereField coachUid == me,
      // or whereField athleteUid == me — the store issues one of each).
      allow list: if isThreadParticipant();

      // A participant creates the thread under the deterministic id, never to
      // themself, with exactly the thread fields and a bounded preview.
      allow create: if isSignedIn()
        && threadId == request.resource.data.coachUid + '_' + request.resource.data.athleteUid
        && (request.auth.uid == request.resource.data.coachUid
            || request.auth.uid == request.resource.data.athleteUid)
        && request.resource.data.coachUid != request.resource.data.athleteUid
        // A block stops a NEW chat too, either direction (fix wave
        // 2026-10-13), not only messages in an existing one.
        && !exists(/databases/$(database)/documents/users/$(request.resource.data.coachUid)/blocked/$(request.resource.data.athleteUid))
        && !exists(/databases/$(database)/documents/users/$(request.resource.data.athleteUid)/blocked/$(request.resource.data.coachUid))
        && request.resource.data.keys().hasOnly(
             ['coachUid', 'athleteUid', 'coachName', 'athleteName',
              'lastMessage', 'lastSender', 'updatedAt'])
        && request.resource.data.coachName is string
        && request.resource.data.athleteName is string
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 300;

      // Participants may only roll the preview forward — uids and names are
      // immutable, and the preview sender must be the writer.
      allow update: if isThreadParticipant()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastMessage', 'lastSender', 'updatedAt'])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 300
        && request.resource.data.lastSender == request.auth.uid;

      allow delete: if false;

      match /messages/{msgId} {
        // Membership lives on the parent thread doc — one get() per rule.
        function parentData() {
          return get(/databases/$(database)/documents/threads/$(threadId)).data;
        }

        allow read: if isSignedIn()
          && (request.auth.uid == parentData().coachUid
              || request.auth.uid == parentData().athleteUid);

        // The other participant, for the block check below.
        function recipientUid() {
          return request.auth.uid == parentData().coachUid ? parentData().athleteUid : parentData().coachUid;
        }

        allow create: if isSignedIn()
          && request.resource.data.senderUid == request.auth.uid
          && (request.auth.uid == parentData().coachUid
              || request.auth.uid == parentData().athleteUid)
          // Blocked means blocked (audit 2026-10-10): a sender the
          // recipient blocked can't write, not just hidden client-side.
          && !exists(/databases/$(database)/documents/users/$(recipientUid())/blocked/$(request.auth.uid))
          && request.resource.data.keys().hasOnly(['senderUid', 'text', 'sentAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 2000
          // Human pace: one message a second, stamped in the same batch.
          && humanPaced('lastMessageAt', 1);

        // Messages are immutable — sent means sent.
        allow update, delete: if false;
      }
    }

    // Community feed — the real For You surface. One doc per post, visible to
    // every signed-in user. Honesty guarantees enforced here:
    //   • authorUid is always the writer (no ghost authors),
    //   • text is bounded 1..1000; workoutName ≤80; repostOfAuthor ≤60,
    //   • `verified` may only mirror a badge the server actually granted
    //     (users/{uid}.verified) — same pattern as the leaderboard entries,
    //     so no self-minted blue checks in the feed,
    //   • posts are immutable once published (edit = delete + repost),
    //   • only the author deletes their own post.
    // NOTE: editing this file changes nothing until published — run
    // `python3 Tools/publish_rules.py` (compiles, releases, byte-verifies),
    // then `python3 Tools/verify_rules_live.py` for behavioral proof.
    match /posts/{postId} {
      // Private account (2026-10-12): a post marked authorPrivate reads
      // only for its author and their accepted connections. Feed queries
      // filter authorPrivate == false, or name one author, so the rule is
      // provable per query; an unfiltered feed query is denied.
      allow get: if isSignedIn() && (
        resource.data.get('authorPrivate', false) == false
        || request.auth.uid == resource.data.authorUid
        || connectedWith(resource.data.authorUid));
      allow list: if isSignedIn() && (
        resource.data.authorPrivate == false
        || request.auth.uid == resource.data.authorUid
        || connectedWith(resource.data.authorUid));

      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['authorUid', 'authorName', 'verified', 'text', 'workoutName',
              'repostOfId', 'repostOfAuthor', 'createdAt',
              'durationMinutes', 'setCount', 'exerciseCount', 'prNames',
              'authorAccent', 'authorHeadline', 'imageB64', 'authorPrivate'])
        // Private account (2026-10-10): a bool the author's clients read
        // to show the post only to connections.
        // Every post says whether it is private — the read rules and the
        // feed query both depend on the field being present.
        && request.resource.data.authorPrivate is bool
        // Capture-camera photo (base64 JPEG). 90k chars ≈ 64KB — big enough
        // for a 720px feed image, small enough that a 20-post page stays
        // within Spark's egress budget.
        && (!('imageB64' in request.resource.data)
            || (request.resource.data.imageB64 is string
                && request.resource.data.imageB64.size() >= 1
                && request.resource.data.imageB64.size() <= 90000))
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() >= 1
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 1000
        && (!('workoutName' in request.resource.data)
            || (request.resource.data.workoutName is string
                && request.resource.data.workoutName.size() <= 80))
        && (!('repostOfId' in request.resource.data)
            || request.resource.data.repostOfId is string)
        && (!('repostOfAuthor' in request.resource.data)
            || (request.resource.data.repostOfAuthor is string
                && request.resource.data.repostOfAuthor.size() <= 60))
        // Structured session stats (auto-share workout cards) — optional,
        // bounded ints and at most 3 PR names. Bounds are sanity caps, not
        // proof of honesty; proof comes from the linked coach relationship,
        // never from a feed post.
        && (!('durationMinutes' in request.resource.data)
            || (request.resource.data.durationMinutes is int
                && request.resource.data.durationMinutes >= 0
                && request.resource.data.durationMinutes <= 1440))
        && (!('setCount' in request.resource.data)
            || (request.resource.data.setCount is int
                && request.resource.data.setCount >= 0
                && request.resource.data.setCount <= 500))
        && (!('exerciseCount' in request.resource.data)
            || (request.resource.data.exerciseCount is int
                && request.resource.data.exerciseCount >= 0
                && request.resource.data.exerciseCount <= 100))
        && (!('prNames' in request.resource.data)
            || (request.resource.data.prNames is list
                && request.resource.data.prNames.size() <= 3))
        // Self-declared identity color (palette id string) — cosmetic, the
        // client maps unknown values to the default. Bounded, never trusted.
        && (!('authorAccent' in request.resource.data)
            || (request.resource.data.authorAccent is string
                && request.resource.data.authorAccent.size() <= 24))
        // Author byline ("Strength · 12-day streak") — display text, bounded.
        // Like every post field, a bound is a sanity cap, not proof.
        && (!('authorHeadline' in request.resource.data)
            || (request.resource.data.authorHeadline is string
                && request.resource.data.authorHeadline.size() <= 80))
        && (request.resource.data.get('verified', false) != true
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('verified', false) == true)
        // Human pace (human-only policy): 45 s between posts, stamped in
        // the same batch as the post.
        && humanPaced('lastPostAt', 45);

      // Posts are immutable — published means published. The one
      // exception is the author's own private/public flag (2026-10-10):
      // flipping the account re-stamps old posts, nothing else changes.
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.authorUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authorPrivate'])
        && request.resource.data.authorPrivate is bool;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.authorUid;

      // Reactions: one doc per user per post ({ value: true, type?,
      // createdAt }) — the doc id IS the reactor's uid, so real counts come
      // from counting docs and nobody can inflate a post beyond their single
      // reaction. Update is allowed (same shape) so changing the reaction
      // TYPE rewrites the same doc without moving the count.
      match /reactions/{uid} {
        allow read: if isSignedIn();
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['value', 'createdAt', 'type'])
          && request.resource.data.value == true
          && (!('type' in request.resource.data)
              || request.resource.data.type in ['heart', 'fire', 'power', 'clap']);
        allow delete: if isOwner(uid);
      }

      // Comments: one doc per comment, immutable once posted (same
      // "published means published" rule as posts); only the comment's
      // author deletes it. No counters anywhere — counts come from reading
      // the docs themselves.
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.keys().hasOnly(
               ['authorUid', 'authorName', 'text', 'createdAt'])
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() >= 1
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 300
          // Human pace: 8 s between comments.
          && humanPaced('lastCommentAt', 8);
        allow update: if false;
        allow delete: if isSignedIn() && request.auth.uid == resource.data.authorUid;
      }
    }

    // Default deny for anything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
